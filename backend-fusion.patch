+REFERENTIEL = traitement.preparer_referentiel(traitement.lire_csv(DOSSIER / "referentiel_aerodromes.csv"))
+ANOMALIES = traitement.detecter_anomalies(DONNEES)
+PIC = next(a for a in ANOMALIES if a["type"] == "pic_atypique")
+
